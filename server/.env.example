# 留空时使用 data/sana_data.sqlite3。生产改为 postgresql://user:pass@host:5432/ekko
DATABASE_URL=
# 留空时会话保存在本机数据库。填写后登录会话、失败次数走 Redis；Redis 不可用时拒绝新登录。
REDIS_URL=
# 留空时图片仍保存在数据库。填写后原图同时写入对象存储，浏览器地址仍是 /media/{id}
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# 反向代理终止 HTTPS 时设为 1，使登录来源校验和 Cookie 使用 https。
EKKO_SECURE=0
EKKO_ALLOWED_HOSTS=
EKKO_ENV=development
EKKO_AUTO_BACKUP=1
